# Copie para .env e ajuste os valores:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)

# Banco de dados (SQLite em desenvolvimento)
DATABASE_URL=sqlite:///./napne.db

# JWT — troque SECRET_KEY por um valor aleatório em produção
SECRET_KEY=altere-esta-chave-secreta
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — origens do frontend (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Servidor de desenvolvimento
APP_HOST=127.0.0.1
APP_PORT=8000
